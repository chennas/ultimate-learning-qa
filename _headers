# Browser Caching Headers for GitHub Pages
# These headers optimize caching for static assets

# Cache JavaScript bundles (immutable - they have content hashes)
/static/js/*
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS files (immutable - they have content hashes)
/static/css/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images and media (immutable)
/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# Cache JSON module files for 1 day (revalidate daily)
*.json
  Cache-Control: public, max-age=86400, must-revalidate

# Cache HTML files for 1 hour (shorter cache for navigation)
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Root index.html - short cache (always fresh)
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Enable gzip compression (GitHub Pages does this automatically)
# This header is informational
/*
  Content-Encoding: gzip
